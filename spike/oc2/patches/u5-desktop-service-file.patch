+
+// Fork seam (spike U5): the app looks for its service under the same identity the CLI registers with, so it never
+// adopts the default `service.json` of another product or profile. LOGINOM_SPIKE_U5_DESKTOP=0 measures the CLI-only seam.
+export function serviceFile() {
+  if (process.env.LOGINOM_SPIKE_U5_DESKTOP === "0") return undefined
+  const identity = process.env.LOGINOM_SPIKE_U5_IDENTITY?.replace(/[^a-zA-Z0-9._-]/g, "-")
+  const state = process.env.XDG_STATE_HOME ?? path.join(homedir(), ".local", "state")
+  return identity ? path.join(state, "opencode", `service-${identity}.json`) : undefined
 }
 
